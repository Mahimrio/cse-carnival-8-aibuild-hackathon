# ============================================================
# CampusOS Environment Variables Configuration
# Copy this file to .env.local and fill in your credentials
# ============================================================

# Supabase Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose-client-side

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Hackathon / Demo Configuration
# DEMO_DATE pins "today" to match seed data dates (YYYY-MM-DD)
DEMO_DATE=2026-09-07

# NEXT_PUBLIC_DEMO_MODE:
# Set to 'true' to instantly auto-login as Super Admin (bypasses login/approval for judges)
# Set to 'false' to test the full RBAC signup -> pending -> admin approval flow
NEXT_PUBLIC_DEMO_MODE=false

# Optional: Email to automatically promote to super_admin on database seed
SUPER_ADMIN_EMAIL=
